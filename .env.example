APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ==========================================
# ZATCA E-Invoicing Configuration
# ==========================================

# Environment: sandbox, simulation, production
ZATCA_ENVIRONMENT=sandbox

# VAT Registration Number (15 digits)
ZATCA_VAT_NUMBER=

# Seller Information
ZATCA_SELLER_NAME=
ZATCA_SELLER_NAME_AR=
ZATCA_REGISTRATION_NUMBER=

# CSR (Certificate Signing Request) Configuration
ZATCA_CSR_ORGANIZATION=
ZATCA_CSR_ORGANIZATION_UNIT=
ZATCA_CSR_COMMON_NAME=

# Invoice Types: 1000=B2C only, 0100=B2B only, 1100=Both
ZATCA_INVOICE_TYPES=1100

# EGS (E-invoice Generation Solution) Unit
ZATCA_EGS_UUID=
ZATCA_EGS_CUSTOM_ID=

# Seller Address
ZATCA_SELLER_STREET=
ZATCA_SELLER_BUILDING=
ZATCA_SELLER_CITY=
ZATCA_SELLER_DISTRICT=
ZATCA_SELLER_POSTAL_CODE=

# Business Category
ZATCA_BUSINESS_CATEGORY=

# Optional: Debug mode (saves XML files for inspection)
ZATCA_DEBUG_ENABLED=false

# Optional: Logging
ZATCA_LOGGING_ENABLED=true
ZATCA_LOG_API_CALLS=false
